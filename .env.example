# Required for AI generation and AI translation. Without it the app runs in
# offline mode: a built-in rules engine drafts copy and themes, and translation
# of custom copy is disabled (built-in UI labels are still translated).
ANTHROPIC_API_KEY=

# Public base URL used for live links, QR codes and Open Graph cards.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Blob token: stores cards, RSVPs and photos in Blob (required on Vercel,
# set automatically when you connect a Blob store). Leave empty to use files.
BLOB_READ_WRITE_TOKEN=

# Folder for file storage when Blob isn't configured. Defaults to ./data
DATA_DIR=./data
